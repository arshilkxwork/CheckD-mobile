{
  "info": {
    "name": "CheckD API Collection",
    "description": "Comprehensive Postman API collection for the CheckD care companion and accountability backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Database Connection Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/db-test"
          }
        }
      ]
    },
    {
      "name": "Authentication & Profile",
      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arshil Khan\",\n  \"firstName\": \"Arshil\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"securepassword123\",\n  \"phone\": \"+91 98765 43210\"\n}"
            },
            "url": "{{baseUrl}}/signup"
          }
        },
        {
          "name": "User Login (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set('token', res.token);",
                  "    console.log('Saved token to environment:', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arshil@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Get Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Keeping my loved ones healthy & happy ❤️\",\n  \"avatarColor\": \"#6B9E7E\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update Privacy Settings",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showCompletedTasks\": true,\n  \"showExactTimes\": true,\n  \"showMedicationNames\": true,\n  \"shareHistory\": true,\n  \"requireProof\": false\n}"
            },
            "url": "{{baseUrl}}/users/me/privacy"
          }
        },
        {
          "name": "Update Notification Preferences",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"reminderInterval\": 15,\n  \"quietHoursStart\": \"22:00\",\n  \"quietHoursEnd\": \"07:00\",\n  \"sounds\": true,\n  \"vibration\": true\n}"
            },
            "url": "{{baseUrl}}/users/me/notifications"
          }
        }
      ]
    },
    {
      "name": "Accountability Circle (Connections)",
      "item": [
        {
          "name": "Get Circle Connections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/connections"
          }
        },
        {
          "name": "Add Person to Circle",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah\",\n  \"firstName\": \"Sarah\",\n  \"email\": \"sarah@example.com\",\n  \"relationship\": \"partner\",\n  \"avatarColor\": \"#C2796B\",\n  \"accountabilityLevel\": \"checkin\"\n}"
            },
            "url": "{{baseUrl}}/connections"
          }
        }
      ]
    },
    {
