              "raw": "{\n  \"status\": \"taken\",\n  \"note\": \"Taken on schedule\"\n}"
            },
            "url": "{{baseUrl}}/medications/1/take"
          }
        },
        {
          "name": "Refill Medication Supply",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addedUnits\": 30\n}"
            },
            "url": "{{baseUrl}}/medications/1/refill"
          }
        },
        {
          "name": "Get Medication Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/medications/logs"
          }
        }
      ]
    },
