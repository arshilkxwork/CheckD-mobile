              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amlodipine\",\n  \"dosage\": \"5mg\",\n  \"form\": \"tablet\",\n  \"color\": \"#3B82F6\",\n  \"instructions\": \"Take 1 tablet every morning\",\n  \"frequency\": \"once_daily\",\n  \"times\": [\"08:00\"],\n  \"currentSupply\": 28,\n  \"totalCapacity\": 30,\n  \"lowSupplyThreshold\": 5,\n  \"prescribingDoctor\": \"Dr. Sharma\"\n}"
            },
            "url": "{{baseUrl}}/medications"
          }
