            },
            "url": "{{baseUrl}}/nudges/1/complete"
          }
        },
        {
          "name": "Snooze Nudge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minutes\": 15\n}"
            },
            "url": "{{baseUrl}}/nudges/1/snooze"
          }
        }
      ]
    },
    {
      "name": "Care Cabinet (Medications)",
      "item": [
        {
          "name": "Get All Medications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/medications"
          }
        },
